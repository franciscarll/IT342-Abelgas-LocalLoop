<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_error_card.xml
    Matches web errorMsg style exactly:
      background:   #FFF5F5  (very light red)
      border:       1px solid #FFCDD2  (soft red border)
      borderRadius: 8px → 8dp

    Place in:  res/drawable/bg_error_card.xml

    Usage in layout:
        android:background="@drawable/bg_error_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"

    Text inside should use:
        android:textColor="#E53935"
        android:textSize="13sp"
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFF5F5" />

    <stroke
        android:width="1dp"
        android:color="#FFCDD2" />

    <corners android:radius="8dp" />

</shape>