<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#F0ECE6"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- LEFT: Category icon bubble (44×44) -->
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_category_icon"
            android:gravity="center"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Category"
                android:src="@drawable/ic_category_other"
                app:tint="@color/primary"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- CENTER: All text content stacked vertically -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ROW 1: Category badge (above title, standalone) -->
            <TextView
                android:id="@+id/tvCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_category_tag"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="Errand"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- ROW 2: Title (full width, no competing sibling) -->
            <TextView
                android:id="@+id/tvFavorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Favor title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- ROW 3: Description snippet -->
            <TextView
                android:id="@+id/tvFavorDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.4"
                android:maxLines="2"
                android:text="Description here…"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <!-- ROW 4: Meta — avatar · name · barangay · time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAvatarMini"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_avatar_circle" />

                <TextView
                    android:id="@+id/tvRequesterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_weight="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:text="·"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <!-- Barangay gets weight to absorb overflow, truncates if needed -->
                <TextView
                    android:id="@+id/tvBarangay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Barangay"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:text="·"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 min ago"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_weight="0" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT: Claim button or "Your Favor" badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClaim"
                style="@style/Widget.LocalLoop.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Claim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOwnFavorBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_own_favor_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Your Favor"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>