<?xml version="1.0" encoding="utf-8"?>
<!--
    item_activity_favor_card.xml
    State-aware card used by all 3 tabs in MyActivityActivity.
    Action rows are shown/hidden by MyActivityFavorAdapter based on
    tab + favor.status — matching web PostedFavorCard / ClaimedFavorCard logic.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_white"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Row 1: Status badge (right-aligned) ──────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_tag"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="OPEN"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ── Title ────────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Favor title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"/>

        <!-- ── Description ──────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description..."
            android:textColor="#666666"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="6dp"/>

        <!-- ── Meta line (Posted / Claimed by / Completed) ──────────────── -->
        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Posted Feb 21"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <!-- ── Claimer / Helper row (CLAIMED + COMPLETED states) ────────── -->
        <LinearLayout
            android:id="@+id/layoutClaimerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvClaimerInitial"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/primary"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvClaimerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Claimed by Carlo Reyes"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <!-- +1 rep badge — shown only on Completed tab -->
            <TextView
                android:id="@+id/tvRepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_tag"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="+1 pt"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ── Divider ───────────────────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="10dp"/>

        <!-- ════════════════════════════════════════════════════════════════
             ACTION ROWS — only one is visible at a time per card
             ════════════════════════════════════════════════════════════════ -->

        <!-- ── OPEN actions: Delete button (Edit is future TODO) ─────────── -->
        <LinearLayout
            android:id="@+id/layoutOpenActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone">

            <Button
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑 Delete"
                android:textSize="12sp"
                android:textColor="#E53935"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#FFCDD2"
                app:cornerRadius="8dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ── Delete confirmation row ───────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutDeleteConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete this favor?"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnConfirmDelete"
                    style="@style/Widget.LocalLoop.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#E53935"
                    android:text="Yes, Delete"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnCancelDelete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Cancel"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── CLAIMED actions: Confirm Completion + Re-open ────────────── -->
        <LinearLayout
            android:id="@+id/layoutClaimedActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Confirm Completion — green, prominent -->
            <Button
                android:id="@+id/btnConfirmComplete"
                style="@style/Widget.LocalLoop.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#2E7D32"
                android:text="✓ Confirm Completion"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="8dp"/>

            <!-- Re-open — outlined orange, secondary action -->
            <Button
                android:id="@+id/btnReopen"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="↺ Re-open Favor"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/primary_very_light"
                app:cornerRadius="10dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ── CLAIMED tab: Cancel Claim ────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutCancelClaimActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone">

            <Button
                android:id="@+id/btnCancelClaim"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✕ Cancel Claim"
                android:textSize="12sp"
                android:textColor="#C62828"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#FFCDD2"
                app:cornerRadius="10dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ── COMPLETED info (for Posted tab, COMPLETED status) ─────────── -->
        <TextView
            android:id="@+id/tvCompletedInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed Feb 21"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:visibility="gone"/>

        <!-- ── EXPIRED info ──────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvExpiredInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ This favor has expired"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>