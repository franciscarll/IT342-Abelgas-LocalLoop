<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_login.xml — REFINED
    Matches LocalLoop web app branding:
      • Primary:       #C8601A  (burnt orange)
      • Background:    #FAF7F2  (soft cream)
      • Card:          #FFFFFF  (white)
      • Input border:  #E8E8E8  → focused: #C8601A
      • Error card:    bg #FFF5F5, border #FFCDD2, text #E53935
      • Button h:      52dp  (leaner, matches web 46px feel)
      • Corner radius: 12dp on inputs, 12dp on buttons
    No logic changes — only visual refinements.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════
             ORANGE HEADER
             ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_wave"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="52dp"
            android:paddingBottom="32dp"
            android:paddingHorizontal="24dp">

            <!-- Logo mark -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_localloop_logo"
                android:contentDescription="LocalLoop logo" />

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="LocalLoop"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Your barangay, connected."
                android:textColor="#F0E0D0"
                android:textSize="13sp" />

            <!-- Feature icons row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:divider="@android:drawable/divider_horizontal_bright"
                android:showDividers="none">

                <!-- Errands -->
                <LinearLayout style="@style/FeatureIconItem">
                    <LinearLayout style="@style/FeatureIconBubble">
                        <ImageView
                            style="@style/FeatureIconImage"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:contentDescription="Errands" />
                    </LinearLayout>
                    <TextView style="@style/FeatureIconLabel" android:text="Errands" />
                </LinearLayout>

                <!-- Favors -->
                <LinearLayout style="@style/FeatureIconItem">
                    <LinearLayout style="@style/FeatureIconBubble">
                        <ImageView
                            style="@style/FeatureIconImage"
                            android:src="@android:drawable/ic_menu_share"
                            android:contentDescription="Favors" />
                    </LinearLayout>
                    <TextView style="@style/FeatureIconLabel" android:text="Favors" />
                </LinearLayout>

                <!-- Plant Care -->
                <LinearLayout style="@style/FeatureIconItem">
                    <LinearLayout style="@style/FeatureIconBubble">
                        <ImageView
                            style="@style/FeatureIconImage"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:contentDescription="Plant Care" />
                    </LinearLayout>
                    <TextView style="@style/FeatureIconLabel" android:text="Plant Care" />
                </LinearLayout>

                <!-- Community -->
                <LinearLayout style="@style/FeatureIconItem">
                    <LinearLayout style="@style/FeatureIconBubble">
                        <ImageView
                            style="@style/FeatureIconImage"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:contentDescription="Community" />
                    </LinearLayout>
                    <TextView style="@style/FeatureIconLabel" android:text="Community" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════
             CREAM FORM SECTION
             ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back 👋"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Log in to your LocalLoop account."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- ─── White card ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_form_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Email label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Email address"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Email field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.LocalLoop.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="you@email.com"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:paddingVertical="13dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password row: label + forgot -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Password"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Forgot password?"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Password field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.LocalLoop.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/text_hint"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Your password"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:paddingVertical="13dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ─── Error card (matches web: #fff5f5 bg, #ffcdd2 border) ─── -->
                <LinearLayout
                    android:id="@+id/cardLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_error_card"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvLoginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#E53935"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Log In button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.LocalLoop.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="Log In"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- OR divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:text="or"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />
                </LinearLayout>

                <!-- Continue with Google (outlined, white bg) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.LocalLoop.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Continue with Google"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="start"
                    app:iconPadding="10dp"
                    app:iconTint="@null" />

            </LinearLayout>

            <!-- Sign up link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign up"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>